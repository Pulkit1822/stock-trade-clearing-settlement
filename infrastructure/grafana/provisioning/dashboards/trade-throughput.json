{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Trade Submission Rate (trades/s)",
      "description": "Rate of HTTP POST /api/v1/trades over 5 minutes. Drop → trades are not reaching trade-service.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\", method=\"POST\"}[5m]))",
          "legendFormat": "Trade submissions/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Trade Submission p99 Latency (ms)",
      "description": "99th percentile end-to-end latency for POST /api/v1/trades including DB write and Kafka publish. SLO target: < 200ms.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"trade-service\", uri=\"/api/v1/trades\", method=\"POST\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99 latency (ms)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"trade-service\", uri=\"/api/v1/trades\", method=\"POST\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 latency (ms)",
          "refId": "B"
        }
      ]
    },

    {
      "id": 3,
      "title": "Trade Submission Errors (4xx + 5xx /s)",
      "description": "Rate of validation failures (4xx) and internal errors (5xx) for trade submissions.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\", status=~\"4..\"}[5m]))",
          "legendFormat": "4xx (validation rejected)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx (internal error)",
          "refId": "B"
        }
      ]
    },

    {
      "id": 4,
      "title": "Total Trades Submitted (cumulative)",
      "description": "Running total of trades submitted since service start. Useful for verifying test scenario counts.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\", method=\"POST\", status=\"201\"})",
          "legendFormat": "Total Submitted",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Trade Success Rate (%)",
      "description": "Percentage of trade submissions that returned 201 Created. SLO target: ≥ 99.9%.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\", status=\"201\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"trade-service\", uri=\"/api/v1/trades\"}[5m]))",
          "legendFormat": "Success %",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Position Updates Rate (positions/s)",
      "description": "Rate of position updates processed by position-service. Should match trade submission rate (1:2 — buyer + seller).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(spring_kafka_listener_seconds_count{job=\"position-service\"}[5m]))",
          "legendFormat": "Position updates/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Clearing Events Processed Rate (events/s)",
      "description": "Rate of settlement-completed events published by clearing-service. Indicates the clearing throughput.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(spring_kafka_listener_seconds_count{job=\"clearing-service\"}[5m]))",
          "legendFormat": "Clearing events/s",
          "refId": "A"
        }
      ]
    }

  ],

  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["clearing", "trades", "throughput"],
  "templating": {
    "list": [
      {
        "hide": 2,
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Clearing Platform — Trade Throughput",
  "uid": "clearing-trade-throughput",
  "version": 1
}
