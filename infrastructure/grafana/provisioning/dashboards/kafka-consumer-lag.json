{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Consumer Lag — All Groups",
      "description": "Outstanding messages not yet consumed. High lag = consumer is falling behind producers. Alert if lag > 1000.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{job=~\"$service\"}) by (job, topic)",
          "legendFormat": "{{job}} → {{topic}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Consumer Lag — trade-submitted (position-service)",
      "description": "Lag on the trade-submitted topic consumed by position-service. This measures how far behind position calculation is.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{job=\"position-service\"}) by (topic)",
          "legendFormat": "lag {{topic}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Consumer Lag — position-validated (clearing-service)",
      "description": "Lag on the position-validated topic consumed by clearing-service. Indicates clearing pipeline backlog.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{job=\"clearing-service\"}) by (topic)",
          "legendFormat": "lag {{topic}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Consumer Lag — settlement-completed (notification + trade-service)",
      "description": "Lag on terminal settlement-completed topic. Both notification-service and trade-service consume this. High lag = participants are notified late / trade status update is delayed.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{job=~\"notification-service|trade-service\"}) by (job, topic)",
          "legendFormat": "{{job}} lag {{topic}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Kafka Producer Record Send Rate (records/s)",
      "description": "Rate at which each service is publishing records to Kafka.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kafka_producer_record_send_total{job=~\"$service\"}[5m])) by (job)",
          "legendFormat": "{{job}} send rate",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Kafka Producer Error Rate (errors/s)",
      "description": "Rate of failed produce attempts. Non-zero is an alert condition — messages are being lost.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kafka_producer_record_error_total{job=~\"$service\"}[5m])) by (job)",
          "legendFormat": "{{job}} errors/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Kafka Consumer Throughput (records/s consumed)",
      "description": "Records-per-second consumed across all topics per service.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "options": {
        "legend": { "calcs": ["mean", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total{job=~\"$service\"}[5m])) by (job)",
          "legendFormat": "{{job}} consumed/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "Kafka Consumer Poll Latency p99 (ms)",
      "description": "p99 time for consumer.poll() calls. High poll latency causes lag growth.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "spring_kafka_listener_seconds_max{job=~\"$service\"} * 1000",
          "legendFormat": "{{job}} max poll ms",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Kafka Consumer Re-balance Events",
      "description": "Count of consumer group re-balances. Frequent re-balances cause temporary lag spikes and processing pauses.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 33 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(kafka_consumer_coordinator_rebalance_total{job=~\"$service\"}[5m])",
          "legendFormat": "{{job}} re-balances",
          "instant": true,
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Max Lag (single worst partition)",
      "description": "The highest consumer lag across a single partition. Even if average lag is 0, one stuck partition can stall processing.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 33 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(kafka_consumer_fetch_manager_records_lag{job=~\"$service\"}) by (job)",
          "legendFormat": "{{job}} max partition lag",
          "instant": true,
          "refId": "A"
        }
      ]
    }

  ],

  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["clearing", "kafka", "consumer-lag"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(up, job)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(up, job)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Service"
      },
      {
        "hide": 2,
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Clearing Platform — Kafka Consumer Lag",
  "uid": "clearing-kafka-lag",
  "version": 1
}
