{
	"info": {
		"_postman_id": "c7a021bb-21b9-4674-8b65-e9cc5c6c6f66",
		"name": "Post-Trade Clearing End-to-End",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get JWT Token (OAuth2 Keycloak)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"jwt_token\", jsonData.access_token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "client_id",
							"value": "clearing-api",
							"type": "text"
						},
						{
							"key": "username",
							"value": "trader1",
							"type": "text"
						},
						{
							"key": "password",
							"value": "password",
							"type": "text"
						},
						{
							"key": "grant_type",
							"value": "password",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "http://localhost:8180/realms/clearing/protocol/openid-connect/token",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8180",
					"path": [
						"realms",
						"clearing",
						"protocol",
						"openid-connect",
						"token"
					]
				}
			}
		},
		{
			"name": "2. Fund Seller Account (Via Gateway)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"accountId\": \"SELLER-001\",\n    \"instrumentId\": \"AAPL\",\n    \"quantity\": 500\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/positions/fund",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"positions",
						"fund"
					]
				}
			}
		},
		{
			"name": "3. Submit Valid Trade (Via Gateway)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"instrumentId\": \"AAPL\",\n    \"buyerAccountId\": \"BUYER-999\",\n    \"sellerAccountId\": \"SELLER-001\",\n    \"quantity\": 100,\n    \"price\": 150.75\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/trades",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"trades"
					]
				}
			}
		}
	]
}
